# CrazzyDocs Environment Configuration Template
# Copy this file to .env.local and fill in your confidential credentials.
# NEVER commit .env.local, token.json, or client_secrets.json to version control!

# --- System & Topology ---
WORKSPACE_ROOT="D:/Agents/CrazzyDocs"
AGENT_NAME="crazzydocs"
ENVIRONMENT="production"

# --- Gemini API Configuration ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- YouTube Publishing Engine ---
# Set to 'automatic_public' for autonomous publishing on the 4-cycle schedule,
# or 'manual_approval' for human pre-review before upload.
PUBLISHING_MODE="automatic_public"
YOUTUBE_CLIENT_SECRETS_FILE="backend/client_secrets.json"
YOUTUBE_TOKEN_FILE="backend/token.json"

# --- SMTP Alert & Mobile Dashboard ---
CRAZZYDOCS_SMTP_HOST="smtp.gmail.com"
CRAZZYDOCS_SMTP_PORT="587"
CRAZZYDOCS_SMTP_SECURITY="STARTTLS"
CRAZZYDOCS_SMTP_USER="your-email@gmail.com"
CRAZZYDOCS_SMTP_PASSWORD="your-gmail-app-password"
CRAZZYDOCS_SMTP_SENDER="your-email@gmail.com"
CRAZZYDOCS_ALERT_RECIPIENT="your-email@gmail.com"

# --- Schedule Profiles (Asia/Kolkata) ---
CRAZZYDOCS_SCHEDULE_ENABLED="true"
CRAZZYDOCS_TIMEZONE="Asia/Kolkata"
CRAZZYDOCS_CYCLE_TIMES="00:00,06:00,12:00,18:00"
